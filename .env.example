# Copy to .env and fill in. NEVER commit the real .env file.

# ---- Backend ----
# Used by docker-compose's api service. DATABASE_URL is set by compose itself
# (host `db`), so it is intentionally not listed here.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# Google OAuth2 (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {BACKEND_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URLs (as seen from the browser)
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Optional; defaults to FRONTEND_URL
CORS_ORIGINS=http://localhost:3000

# Emails listed here get role=admin on login (comma separated)
ADMIN_EMAILS=admin@example.com

# Development login (POST /api/auth/dev-login). Keep 0 in production.
ENABLE_DEV_LOGIN=0

# RouterAI (OpenAI-compatible). Key is read on the backend only.
ROUTERAI_API_KEY=
AI_BASE_URL=https://routerai.ru/api/v1/chat/completions
AI_MODEL=qwen/qwen3.5-flash-02-23

MAX_UPLOAD_MB=10

# ---- Frontend (build-time, inlined into the client bundle) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set to 1 to show the "demo login" button on the landing page
NEXT_PUBLIC_ENABLE_DEV_LOGIN=0

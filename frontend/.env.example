# Backend REST API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set to 1 to show the demo-login form on the landing page (backend needs ENABLE_DEV_LOGIN=true)
NEXT_PUBLIC_ENABLE_DEV_LOGIN=0
# Set to 1 on the demo stand: demo-login buttons on the landing and a notice bar in the app.
# Read at build time, so rebuild the image after changing it.
NEXT_PUBLIC_DEMO=0

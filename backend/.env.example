# Copy to backend/.env and adjust. Placeholders only: never commit real secrets.

# Database. SQLite for local dev, PostgreSQL in docker-compose.
DATABASE_URL=sqlite:///./skillpath.db
# DATABASE_URL=postgresql+psycopg://skillpath:skillpath@db:5432/skillpath

# JWT (HS256). Generate a long random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRE_MINUTES=10080

# Google OAuth2 (create credentials in Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Comma-separated. Empty = FRONTEND_URL
CORS_ORIGINS=http://localhost:3000

# Dev-only demo login (POST /api/auth/dev-login). Keep false in production.
ENABLE_DEV_LOGIN=false

# Comma-separated emails that get role=admin on login
ADMIN_EMAILS=admin@example.com

# RouterAI (OpenAI-compatible) for the AI tutor. Key is read on the backend only.
ROUTERAI_API_KEY=your-routerai-api-key
AI_BASE_URL=https://routerai.ru/api/v1/chat/completions
AI_MODEL=qwen/qwen3.5-flash-02-23

# File uploads (served at /uploads)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

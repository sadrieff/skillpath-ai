# Copy to deploy/demo.env on the server and fill in. deploy/demo.env is gitignored.
# Never commit the real file. Lines still containing CHANGE_ME stop setup-server.sh.

# Public host of the stand: a domain (skillpath.example.ru) or <ip-with-dashes>.sslip.io
DEMO_HOST=CHANGE_ME.sslip.io

# Backend secret for signing tokens. Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_MINUTES=10080

# Public URLs as seen from the browser (https, no trailing slash)
BACKEND_URL=https://CHANGE_ME.sslip.io
FRONTEND_URL=https://CHANGE_ME.sslip.io
# Allowed browser origins for CORS; same host as FRONTEND_URL
CORS_ORIGINS=https://CHANGE_ME.sslip.io

# Demo mode: 1 turns on demo-only limits (see docs/deploy-demo.md)
DEMO_MODE=1
# Demo-login by email (POST /api/auth/dev-login). 0 = off, 1 = on.
ENABLE_DEV_LOGIN=0
# Global cap on AI tutor requests per day, for the whole stand
AI_DAILY_LIMIT=300
# Запросов к ИИ на одного посетителя за всё время жизни аккаунта (0 = без лимита)
DEMO_AI_PER_USER=2
# Per-user cap on AI requests per hour
DEMO_RATE_PER_HOUR=20
# Upload size limit in MB
MAX_UPLOAD_MB=2

# Google OAuth (leave empty to use demo login only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails that get role=admin on login, comma separated (empty = nobody)
ADMIN_EMAILS=

# RouterAI key for the AI tutor. Lives only on the server. Empty = AI tutor is unavailable.
ROUTERAI_API_KEY=
AI_BASE_URL=https://routerai.ru/api/v1/chat/completions
AI_MODEL=qwen/qwen3.5-flash-02-23

# PostgreSQL password for the db container. Must match the password in DATABASE_URL below.
POSTGRES_PASSWORD=CHANGE_ME
# Compose overrides the host part with `db` inside the network; keep the password in sync with POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://skillpath:CHANGE_ME@db:5432/skillpath
